{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetaProtocol",
  "description": "SWARAJ extension metadata definitions attached via meta fields.",
  "definitions": {
    "ProvenanceMeta": {
      "type": "object",
      "required": ["field", "confidence", "page", "bbox", "extractor"],
      "properties": {
        "field": { "type": "string" },
        "confidence": { "type": "number" },
        "page": { "type": "integer" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "extractor": { "type": "string" }
      }
    },
    "MakerCheckerMeta": {
      "type": "object",
      "required": ["maker", "status", "timestamp"],
      "properties": {
        "maker": { "type": "string" },
        "checker": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "timestamp": { "type": "string" }
      }
    },
    "DeliverableMeta": {
      "type": "object",
      "required": ["type", "draft", "parameters"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "approval_note",
            "inspection_summary",
            "review_deck",
            "cost_sheet",
            "engineering_calculation"
          ]
        },
        "draft": { "type": "boolean" },
        "parameters": { "type": "object" },
        "citations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SwarajMeta": {
      "type": "object",
      "properties": {
        "provenance": { "$ref": "#/definitions/ProvenanceMeta" },
        "makerChecker": { "$ref": "#/definitions/MakerCheckerMeta" },
        "deliverable": { "$ref": "#/definitions/DeliverableMeta" }
      }
    }
  }
}
