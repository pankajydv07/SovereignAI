{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetaProtocol",
  "description": "SWARAJ extension metadata definitions attached via meta fields.",
  "definitions": {
    "ProvenanceMeta": {
      "type": "object",
      "required": ["field", "confidence", "page", "bbox", "extractor"],
      "properties": {
        "field": { "type": "string" },
        "confidence": { "type": "number" },
        "page": { "type": "integer" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "extractor": { "type": "string" }
      }
    },
    "MakerCheckerMeta": {
      "type": "object",
      "required": ["maker", "status", "timestamp"],
      "properties": {
        "maker": { "type": "string" },
        "checker": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "timestamp": { "type": "string" }
      }
    },
    "DeliverableMeta": {
      "type": "object",
      "required": ["type", "draft", "parameters"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "approval_note",
            "inspection_summary",
            "review_deck",
            "cost_sheet",
            "engineering_calculation"
          ]
        },
        "draft": { "type": "boolean" },
        "parameters": { "type": "object" },
        "citations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CandidateScoreMeta": {
      "type": "object",
      "required": ["modelTag", "qualityPrior", "vramFit", "latencyScore", "swapPenalty", "totalScore", "isWinner", "rejectionReason"],
      "properties": {
        "modelTag": { "type": "string" },
        "qualityPrior": { "type": "number" },
        "vramFit": { "type": "number" },
        "latencyScore": { "type": "number" },
        "swapPenalty": { "type": "number" },
        "totalScore": { "type": "number" },
        "isWinner": { "type": "boolean" },
        "rejectionReason": { "type": ["string", "null"] }
      }
    },
    "RoutingDecisionMeta": {
      "type": "object",
      "required": ["taskClass", "selectedModelTag", "fallbackModelTag", "confidence", "routingLatencyMs", "isManualOverride", "featureVector", "candidates"],
      "properties": {
        "taskClass": { "type": "string" },
        "selectedModelTag": { "type": "string" },
        "fallbackModelTag": { "type": "string" },
        "confidence": { "type": "number" },
        "routingLatencyMs": { "type": "number" },
        "isManualOverride": { "type": "boolean" },
        "degradedReason": { "type": ["string", "null"] },
        "featureVector": { "type": "object" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/definitions/CandidateScoreMeta" }
        }
      }
    },
    "SwarajMeta": {
      "type": "object",
      "properties": {
        "provenance": { "$ref": "#/definitions/ProvenanceMeta" },
        "makerChecker": { "$ref": "#/definitions/MakerCheckerMeta" },
        "deliverable": { "$ref": "#/definitions/DeliverableMeta" },
        "routingDecision": { "$ref": "#/definitions/RoutingDecisionMeta" }
      }
    }
  }
}
