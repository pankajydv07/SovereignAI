{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PermissionProtocol",
  "description": "Permission request and response definitions with permission options.",
  "definitions": {
    "PermissionOption": {
      "type": "string",
      "enum": ["allow_once", "allow_session", "always_allow", "deny"]
    },
    "PermissionRequestParams": {
      "type": "object",
      "required": ["requestId", "tool", "sideEffect", "description", "options"],
      "properties": {
        "requestId": { "type": "string" },
        "tool": { "type": "string" },
        "sideEffect": { "type": "string" },
        "description": { "type": "string" },
        "resource": { "type": "string" },
        "resourcePattern": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/definitions/PermissionOption" }
        },
        "diff": { "$ref": "content.json#/definitions/DiffContent" }
      }
    },
    "PermissionResponseParams": {
      "type": "object",
      "required": ["requestId", "selectedOption"],
      "properties": {
        "requestId": { "type": "string" },
        "selectedOption": { "$ref": "#/definitions/PermissionOption" },
        "resourcePattern": { "type": "string" }
      }
    }
  }
}
