{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InitializeProtocol",
  "description": "Initialization handshake definitions with protocol version negotiation and capabilities.",
  "definitions": {
    "InitializeParams": {
      "type": "object",
      "required": ["protocolVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "InitializeResult": {
      "type": "object",
      "required": ["protocolVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
