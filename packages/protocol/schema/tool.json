{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolProtocol",
  "description": "Tool execution status, kinds, stop reasons, and streaming update shapes.",
  "definitions": {
    "ToolCallStatus": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed"]
    },
    "ToolKind": {
      "type": "string",
      "enum": ["read", "edit", "delete", "move", "search", "execute", "think", "fetch", "other"]
    },
    "StopReason": {
      "type": "string",
      "enum": ["end_turn", "max_tokens", "max_turn_requests", "refusal", "cancelled"]
    },
    "ToolCallUpdate": {
      "type": "object",
      "required": ["toolCallId", "name", "kind", "status"],
      "properties": {
        "toolCallId": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "$ref": "#/definitions/ToolKind" },
        "status": { "$ref": "#/definitions/ToolCallStatus" },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "error": { "type": "string" }
      }
    }
  }
}
